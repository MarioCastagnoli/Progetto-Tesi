@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix map: <http://mapping.example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix v: <http://rdf.data-vocabulary.org/#> .
@prefix cult: <https://example.ontology.it/onto/cultural/> .
@prefix cis: <http://dati.beniculturali.it/cis/> .
@prefix tiapit: <https://w3id.org/italia/onto/TI/> .
@prefix l0: <https://w3id.org/italia/onto/l0/> .
@prefix clv: <https://w3id.org/italia/onto/CLV/> .
@prefix data: <https://example.lod.it/data/> .

map:map_artworkLocation_000 rml:logicalSource map:source_001 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "artworkLocation" ;
	rr:predicateObjectMap map:pom_006, map:pom_007, map:pom_008, map:pom_009 ;
	rr:subjectMap map:s_001 .

map:map_municipality_000 rml:logicalSource map:source_002 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "municipality" ;
	rr:predicateObjectMap map:pom_010, map:pom_011, map:pom_012 ;
	rr:subjectMap map:s_002 .

map:map_painting_000 rml:logicalSource map:source_000 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "painting" ;
	rr:predicateObjectMap map:pom_000, map:pom_001, map:pom_002, map:pom_003, map:pom_004, map:pom_005 ;
	rr:subjectMap map:s_000 .

map:map_timeReference_000 rml:logicalSource map:source_003 ;
	rdf:type rr:TriplesMap ;
	rdfs:label "timeReference" ;
	rr:predicateObjectMap map:pom_013, map:pom_014 ;
	rr:subjectMap map:s_003 .

map:om_000 rdf:type rr:ObjectMap ;
	rr:constant cult:Painting ;
	rr:termType rr:IRI .

map:om_001 rml:reference "artwork_id" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_002 rml:reference "artwork_title" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_003 rml:reference "artwork_description" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_004 rdf:type rr:ObjectMap ;
	rr:template "https://example.lod.it/data/TimeReference/{time_reference}" ;
	rr:termType rr:IRI .

map:om_005 rdf:type rr:ObjectMap ;
	rr:template "https://example.lod.it/data/ArtworkLocation/{cultural_site_id}" ;
	rr:termType rr:IRI .

map:om_006 rdf:type rr:ObjectMap ;
	rr:constant cult:ArtworkLocation ;
	rr:termType rr:IRI .

map:om_007 rml:reference "cultural_site_id" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_008 rml:reference "cultural_site_name" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_009 rdf:type rr:ObjectMap ;
	rr:template "https://example.lod.it/data/Municipality/{istat_code}" ;
	rr:termType rr:IRI .

map:om_010 rdf:type rr:ObjectMap ;
	rr:constant cult:Municipality ;
	rr:termType rr:IRI .

map:om_011 rml:reference "istat_code" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_012 rml:reference "place_name" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:om_013 rdf:type rr:ObjectMap ;
	rr:constant cult:TimeReference ;
	rr:termType rr:IRI .

map:om_014 rml:reference "time_reference" ;
	rdf:type rr:ObjectMap ;
	rr:termType rr:Literal .

map:pm_000 rdf:type rr:PredicateMap ;
	rr:constant rdf:type .

map:pm_001 rdf:type rr:PredicateMap ;
	rr:constant cult:artworkId .

map:pm_002 rdf:type rr:PredicateMap ;
	rr:constant cult:title .

map:pm_003 rdf:type rr:PredicateMap ;
	rr:constant cult:description .

map:pm_004 rdf:type rr:PredicateMap ;
	rr:constant cult:hasTimeReference .

map:pm_005 rdf:type rr:PredicateMap ;
	rr:constant cult:hasArtworkLocation .

map:pm_006 rdf:type rr:PredicateMap ;
	rr:constant rdf:type .

map:pm_007 rdf:type rr:PredicateMap ;
	rr:constant cult:artworkLocationId .

map:pm_008 rdf:type rr:PredicateMap ;
	rr:constant cult:artworkLocationName .

map:pm_009 rdf:type rr:PredicateMap ;
	rr:constant cult:isLocatedIn .

map:pm_010 rdf:type rr:PredicateMap ;
	rr:constant rdf:type .

map:pm_011 rdf:type rr:PredicateMap ;
	rr:constant cult:istatCode .

map:pm_012 rdf:type rr:PredicateMap ;
	rr:constant l0:name .

map:pm_013 rdf:type rr:PredicateMap ;
	rr:constant rdf:type .

map:pm_014 rdf:type rr:PredicateMap ;
	rr:constant l0:name .

map:pom_000 rdf:type rr:PredicateObjectMap ;
	rr:objectMap map:om_000 ;
	rr:predicateMap map:pm_000 .

