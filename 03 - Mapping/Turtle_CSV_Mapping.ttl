map:rules_000 <http://rdfs.org/ns/void#exampleResource> map:map_artworkLocation_000, map:map_municipality_000, map:map_painting_000, map:map_timeReference_000 ;
	rdf:type <http://rdfs.org/ns/void#Dataset> .

map:s_000 rdf:type rr:SubjectMap ;
	rr:template "https://example.lod.it/data/Painting/{artwork_id}" .

map:s_001 rdf:type rr:SubjectMap ;
	rr:template "https://example.lod.it/data/ArtworkLocation/{cultural_site_id}" .

map:s_002 rdf:type rr:SubjectMap ;
	rr:template "https://example.lod.it/data/Municipality/{istat_code}" .

map:s_003 rdf:type rr:SubjectMap ;
	rr:template "https://example.lod.it/data/TimeReference/{time_reference}" .

map:source_000 rml:referenceFormulation ql:CSV ;
	rml:source "opere_dipinti.csv" ;
	rdf:type rml:LogicalSource .

