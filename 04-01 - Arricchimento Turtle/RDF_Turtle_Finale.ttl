<https://example.lod.it/data/Painting/1400079575> rdf:type cult:Painting ;
	cult:artworkId "1400079575" ;
	cult:description "Dipinto a olio su cartoncino raffigurante una veduta della campagna romana, colta nella quiete dopo un temporale, nel cielo, infatti, si affrontano nubi maestose e squarci di sereno, sullo sfondo si riconosce la sagoma del Mausoleo di Cecilia Metella sulla via Appia" ;
	cult:hasArtworkLocation <https://example.lod.it/data/ArtworkLocation/2c095> ;
	cult:hasTimeReference <https://example.lod.it/data/TimeReference/Fine%20XIX%20secolo> ;
	cult:title "All'acqua Santa, dopo il temporale" .

