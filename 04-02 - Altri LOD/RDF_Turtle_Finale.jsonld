    ],
    "https://example.ontology.it/onto/cultural/description": [
      {
        "@value": "Dipinto a olio su cartoncino raffigurante una veduta della campagna romana, colta nella quiete dopo un temporale, nel cielo, infatti, si affrontano nubi maestose e squarci di sereno, sullo sfondo si riconosce la sagoma del Mausoleo di Cecilia Metella sulla via Appia"
      }
    ],
