      </cult:ArtworkLocation>
    </cult:hasArtworkLocation>
    <cult:hasTimeReference rdf:resource="https://example.lod.it/data/TimeReference/XX%20secolo"/>
    <cult:title>Inverno in Cadore</cult:title>
  </cult:Painting>
