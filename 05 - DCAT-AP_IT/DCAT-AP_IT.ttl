@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatapit: <http://dati.gov.it/onto/dcatapit#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# CATALOGO
# ============================================================

<https://example.lod.it/data/catalog/cultural-heritage-artworks>
    a dcatapit:Catalog, dcat:Catalog ;
    dct:title "Catalogo dati.cultura - Dati aperti del patrimonio culturale"@it ;
    dct:title "dati.cultura Catalog - Open Cultural Heritage Data"@en ;
    dct:description "Catalogo del progetto dati.cultura per la pubblicazione di dataset aperti relativi al patrimonio culturale."@it ;
    dct:description "Catalog of the dati.cultura project for the publication of open datasets related to cultural heritage."@en ;
    dct:issued "2026-09-02"^^xsd:date ;
    dct:modified "2026-09-03"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
    dct:publisher <https://example.lod.it/data/organisation/m_bac> ;
    dcat:dataset <https://example.lod.it/data/dataset/cultural-heritage-artworks> .


# ============================================================
# AGENTE: TITOLARE / EDITORE
# ============================================================

<https://example.lod.it/data/organisation/m_bac>
    a dcatapit:Agent, foaf:Agent ;
    dct:identifier "m_bac" ;
    foaf:name "Ministero della Cultura"@it ;
    foaf:name "Ministry of Culture"@en .


# ============================================================
# DATASET
# ============================================================

<https://example.lod.it/data/dataset/cultural-heritage-artworks>
    a dcatapit:Dataset, dcat:Dataset ;
    dct:identifier "m_bac:cultural-heritage-artworks" ;
    dct:title "Opere d'arte di tipo dipinto"@it ;
    dct:title "Painted artworks"@en ;
    dct:description "Dataset relativo a opere d'arte di tipo dipinto, con identificativo, titolo, descrizione quando disponibile, riferimento temporale, luogo di conservazione o esposizione e comune identificato tramite codice ISTAT."@it ;
    dct:description "Dataset about painted artworks, including identifier, title, description when available, time reference, conservation or exhibition location, and municipality identified through its ISTAT code."@en ;
    dct:issued "2026-09-02"^^xsd:date ;
    dct:modified "2026-09-03"^^xsd:date ;
    dct:publisher <https://example.lod.it/data/organisation/m_bac> ;
    dct:rightsHolder <https://example.lod.it/data/organisation/m_bac> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/UNKNOWN> ;
    dcat:distribution
        <https://example.lod.it/data/distribution/cultural-heritage-artworks-csv>,
        <https://example.lod.it/data/distribution/cultural-heritage-artworks-json>,
        <https://example.lod.it/data/distribution/cultural-heritage-artworks-rdf-turtle>,
        <https://example.lod.it/data/distribution/cultural-heritage-artworks-json-ld>,
        <https://example.lod.it/data/distribution/cultural-heritage-artworks-rdf-xml> .


